modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "artifacts/college-erp: web"

[[workflows.workflow]]
name = "artifacts/college-erp: web"
author = "agent"
mode = "parallel"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/college-erp"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/college-erp run fullstack"
cwd = "./artifacts/college-erp"
waitForPort = 22584
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "22584"
BASE_PATH = "/"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
